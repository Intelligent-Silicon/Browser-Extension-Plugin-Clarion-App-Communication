{
  "manifest_version": 2,
  "name": "ClaAppName",
  "version": "1.0",
  "description": "Recieves WebNavigation Events",

  "applications": {
    "gecko": {
      "id": "0339088b-ba1a-44dd-baee-da8de84e222d@intelligentsilicon"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ]
}