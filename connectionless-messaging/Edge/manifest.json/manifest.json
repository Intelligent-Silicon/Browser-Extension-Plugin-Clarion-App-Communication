{
  "manifest_version": 2,
  "name": "ClaAppName",
  "version": "1.0",
  "description": "Receives WebNavigation Events",

  "background": {
    "scripts": ["background.js"],
    "persistent": true

  },

  "permissions": [
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"

    }
  ]
}